# Real business data — never commit
data/private/*
!data/private/.gitkeep

# Real-trained models — never commit
models/private/*
!models/private/.gitkeep

# Database backups — never commit
backups/*
!backups/.gitkeep

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Real config (contains real local paths/settings) — only config.example.toml is committed
config/config.toml

# Real vendor names, amounts, and person names used by data_cleaning.py —
# only private_cleaning_overrides.example.py (placeholder data) is committed
config/private_cleaning_overrides.py

# Real per-category model performance numbers — never commit
metrics/

# Executed against real data, with real output baked into saved cell
# output (e.g. real category totals, real payment-method values) — never
# commit until explicitly sanitized (see docs/risk_log.md)
notebooks/01_data_exploration.ipynb

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Real prediction/scoring output — derived from real business data
# (real lead names/phone/email, real expense categories), never commit
scored_leads*.csv
predictions_output*.csv
data/scored_leads.csv